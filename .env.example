# ===== Spotify Bar — variáveis de ambiente =====
# Desenvolvimento: copie para api/.env. Produção: cadastre no Portainer (Environment variables).

# --- Obrigatórias em produção ---
DB_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=gere-com-openssl-rand-hex-32
ADMIN_EMAIL=admin@seudominio.com.br             # administrador da plataforma (criado na 1ª subida se não existir)
ADMIN_SENHA=troque-por-uma-senha-forte          # só vale para a criação; depois troque em Responsáveis
ENCRYPTION_KEY=gere-com-openssl-rand-hex-32   # cifra tokens do Spotify/Mercado Pago no banco. NÃO perca: sem ela os tokens salvos ficam ilegíveis.

# --- URLs ---
PUBLIC_URL=https://spotify-bar.umg.com.br     # dev: http://localhost:5175
API_URL=                                      # dev: http://127.0.0.1:3002 (redirect_uri do Spotify exige 127.0.0.1, não "localhost"). Prod: omita (= PUBLIC_URL)

# --- Spotify ---
SPOTIFY_MODE=real                             # mock = Spotify simulado (dev/testes)
# Os aplicativos (Client ID/Secret) são cadastrados no PAINEL: Plataforma > Spotify da plataforma (podem ser vários).
# As duas variáveis abaixo são opcionais: se preenchidas, viram o "App principal" automaticamente na 1ª subida (útil em dev).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect URI a cadastrar em CADA app no Dashboard do Spotify:  ${PUBLIC_URL}/api/spotify/callback

# --- Pix ---
PIX_MODE=real                                 # mock = pagamentos simulados (NUNCA em produção)
PLATFORM_PIX_PROVIDER=estatico                # estatico | mercadopago  (recebimento das ASSINATURAS)
PLATFORM_PIX_KEY=                             # chave Pix da plataforma (provider estatico)
PLATFORM_PIX_NAME=SPOTIFY BAR
PLATFORM_PIX_CITY=SAO PAULO
PLATFORM_MP_ACCESS_TOKEN=                     # provider mercadopago
MP_WEBHOOK_SECRET=                            # segredo na URL do webhook: /api/webhooks/mercadopago?secret=...

# --- Ajustes do player (opcionais) ---
# PLAYER_POLL_MS=4000
# PLAYER_LEAD_MS=20000
# PIX_EXPIRA_MIN=15
